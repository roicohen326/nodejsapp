    "config": "^3.3.12",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node": "^25.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.20",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.24",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
